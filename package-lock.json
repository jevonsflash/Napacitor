{
  "name": "napacitor",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "napacitor",
      "workspaces": [
        "core",
        "cli",
        "maui",
        "plugins/*"
      ],
      "devDependencies": {
        "typescript": "~5.4.5"
      }
    },
    "cli": {
      "name": "@napacitor/cli",
      "version": "0.1.2-beta.0",
      "license": "MIT",
      "bin": {
        "nap": "bin/nap.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "core": {
      "name": "@napacitor/core",
      "version": "0.1.1",
      "license": "MIT",
      "devDependencies": {
        "typescript": "~5.4.5"
      }
    },
    "maui": {
      "name": "@napacitor/maui",
      "version": "0.1.0",
      "license": "MIT",
      "peerDependencies": {
        "@napacitor/core": "^0.1.0"
      }
    },
    "node_modules/@napacitor/battery": {
      "resolved": "plugins/battery",
      "link": true
    },
    "node_modules/@napacitor/cli": {
      "resolved": "cli",
      "link": true
    },
    "node_modules/@napacitor/clipboard": {
      "resolved": "plugins/clipboard",
      "link": true
    },
    "node_modules/@napacitor/core": {
      "resolved": "core",
      "link": true
    },
    "node_modules/@napacitor/device": {
      "resolved": "plugins/device",
      "link": true
    },
    "node_modules/@napacitor/haptics": {
      "resolved": "plugins/haptics",
      "link": true
    },
    "node_modules/@napacitor/maui": {
      "resolved": "maui",
      "link": true
    },
    "node_modules/@napacitor/share": {
      "resolved": "plugins/share",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.4.5",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.4.5.tgz",
      "integrity": "sha512-vcI4UpRgg81oIRUFwR0WSIHKt11nJ7SAVlYNIu+QpqeyXP+gpQJy/Z4+F0aGxSE4MqwjyXvW/TzgkLAx2AGHwQ==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "plugins/battery": {
      "name": "@napacitor/battery",
      "version": "0.1.0",
      "license": "MIT",
      "devDependencies": {
        "@napacitor/core": "^0.1.0",
        "typescript": "~5.4.5"
      },
      "peerDependencies": {
        "@napacitor/core": "^0.1.0"
      }
    },
    "plugins/clipboard": {
      "name": "@napacitor/clipboard",
      "version": "0.1.0",
      "license": "MIT",
      "devDependencies": {
        "@napacitor/core": "^0.1.0",
        "typescript": "~5.4.5"
      },
      "peerDependencies": {
        "@napacitor/core": "^0.1.0"
      }
    },
    "plugins/device": {
      "name": "@napacitor/device",
      "version": "0.1.0",
      "license": "MIT",
      "devDependencies": {
        "@napacitor/core": "^0.1.0",
        "typescript": "~5.4.5"
      },
      "peerDependencies": {
        "@napacitor/core": "^0.1.0"
      }
    },
    "plugins/haptics": {
      "name": "@napacitor/haptics",
      "version": "0.1.0",
      "license": "MIT",
      "devDependencies": {
        "@napacitor/core": "^0.1.0",
        "typescript": "~5.4.5"
      },
      "peerDependencies": {
        "@napacitor/core": "^0.1.0"
      }
    },
    "plugins/share": {
      "name": "@napacitor/share",
      "version": "0.1.0",
      "license": "MIT",
      "devDependencies": {
        "@napacitor/core": "^0.1.0",
        "typescript": "~5.4.5"
      },
      "peerDependencies": {
        "@napacitor/core": "^0.1.0"
      }
    }
  }
}
