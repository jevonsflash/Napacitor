@inject IJSRuntime JS
@*
    Napacitor 宿主根组件:不渲染任何内容,仅在首次渲染后启动 Napacitor 运行时
    (发现插件 → 注入原生桥 → 按 napacitor.entries.json 导入 Web 应用入口脚本)。
    宿主无需任何 Napacitor 配置代码 —— 插件由运行时反射自动发现。
*@

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Console.WriteLine("[NapacitorHost] OnAfterRenderAsync(firstRender) 触发,开始启动运行时");
        try
        {
            await NapacitorRuntime.StartAsync(JS);
            Console.WriteLine("[NapacitorHost] NapacitorRuntime.StartAsync 完成");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NapacitorHost] 启动失败:{ex}");
            var message = System.Text.Json.JsonSerializer.Serialize($"启动失败:{ex.Message}");
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"try{{document.getElementById('status').textContent={message}}}catch(e){{}}");
            }
            catch
            {
                // JSInterop 已不可用时仅保留控制台日志
            }
        }
    }
}
