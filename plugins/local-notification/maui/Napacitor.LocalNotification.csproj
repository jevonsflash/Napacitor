<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      多目标说明(本插件与其余 Napacitor 插件不同,非 net10.0 单目标):
      本地通知必须实现平台回调类型 —— iOS/Mac Catalyst 的
      UNUserNotificationCenterDelegate、Android 的 BroadcastReceiver、
      Windows 的 AppNotificationManager.NotificationInvoked ——
      这些类型只在平台 TFM 中可用,纯 net10.0 无法引用。
      net10.0 目标提供桩实现(全部方法抛 NOT_IMPLEMENTED),
      保证未安装对应平台工作负载的环境仍可编译。
    -->
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>Napacitor.Plugins.LocalNotification</RootNamespace>
    <AssemblyName>Napacitor.LocalNotification</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Description>Napacitor LocalNotification 插件(.NET MAUI 实现)</Description>
    <Version>0.1.0</Version>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!--
      AppNotifications API(与 MAUI 10.0.20 引用的 WindowsAppSDK 版本一致)。
      ExcludeAssets 排除 build/buildTransitive/analyzers:类库不参与
      PRI/清单生成,运行时资产由 MAUI 宿主(UseMaui)提供,导入其
      targets 反而会与宿主重复。
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250909003"
                      ExcludeAssets="build;buildTransitive;analyzers" />
  </ItemGroup>

  <ItemGroup>
    <!--
      运行时引用,按包的两种所在布局解析(本工程仅作为宿主的依赖被编译,不单独构建):
      - npm 安装布局:node_modules/@napacitor/<p>/maui/ → 相邻的 @napacitor/maui 包
      - 仓库源码布局:plugins/<p>/maui/ → 顶层 maui/
      注意:MSBuild 不对 junction/符号链接路径做规范化,相对引用按字面路径解析。
    -->
    <ProjectReference Include="..\..\maui\src\Napacitor.csproj" Condition="Exists('..\..\maui\src\Napacitor.csproj')" />
    <ProjectReference Include="..\..\..\maui\src\Napacitor.csproj" Condition="!Exists('..\..\maui\src\Napacitor.csproj')" />
  </ItemGroup>

</Project>
